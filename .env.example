# Website (frontend) environment variables. Copy to `.env` for local development;
# on Vercel add them in Project → Settings → Environment Variables.
# The database settings live with the backend — see backend/.env.example.

# Address of the backend API, e.g. https://api.realmovingcanada.ca/api
# (leave empty locally: /api is proxied to the backend on port 4000)
VITE_API_BASE=

# Public address of this website — canonical links, social previews and sitemap
VITE_SITE_URL=

# Require sign-in for /dashboard (set to false only to preview the screens without the API)
VITE_REQUIRE_AUTH=true

# Formspree form endpoint (quote/contact/review emails)
VITE_FORMSPREE_ENDPOINT=
