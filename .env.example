# Copy to .env for local development. In production set these in
# Vercel → Project → Settings → Environment Variables (never commit real values).

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="realmovingcanada"

# Long random secret for signing session cookies (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Public site address — used in password-reset links, canonical URLs and the sitemap
APP_URL="http://localhost:5173"
VITE_SITE_URL="https://real-moving-canada-ddne.vercel.app"

# Email via Resend (https://resend.com). Without a key, emails are printed to the console.
RESEND_API_KEY=""
EMAIL_FROM="Real Moving Canada <no-reply@yourdomain.ca>"
# Where new quote-request notifications are sent
STAFF_NOTIFY_EMAIL=""

# Frontend: require sign-in for /dashboard (set to false only to preview the portal without the API)
VITE_REQUIRE_AUTH="true"
