{
  "name": "real-moving-canada-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real Moving Canada API — Express + MongoDB Atlas. Serves https://api.realmovingcanada.ca/api for the website.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "make:admin": "node --env-file-if-exists=.env scripts/make-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
