# Real Moving Canada API — environment variables.
# Copy to `.env` for local development; on the hosting platform, add the same names
# in its environment-variable settings. Never commit real values.

# ── Database (MongoDB Atlas → Connect → Drivers) ─────────────────────────────
MONGODB_URI=
MONGODB_DB=realmovingcanada

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Website that calls this API ─────────────────────────────────────────────
# Main site address (used in password-reset links).
FRONTEND_URL=
# Every site address allowed to call the API (CORS), comma-separated.
# e.g. https://realmovingcanada.ca,https://www.realmovingcanada.ca,http://localhost:5173
CORS_ORIGINS=

# ── Sessions ────────────────────────────────────────────────────────────────
# Long random secret (48+ characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# lax  → website and API share a domain (realmovingcanada.ca + api.realmovingcanada.ca)
# none → website and API are on different domains (e.g. a *.vercel.app preview)
COOKIE_SAMESITE=lax

# ── Email (Resend — https://resend.com) ─────────────────────────────────────
# Without a key, emails are printed to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=
# Where new quote-request notifications are sent
STAFF_NOTIFY_EMAIL=
